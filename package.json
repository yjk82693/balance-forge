{
  "name": "balance-forge",
  "private": true,
  "version": "0.1.0",
  "description": "AI playtesting platform for game developers — HackPrinceton Fall 2026",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test",
    "check:secrets": "node tools/check-secrets.mjs",
    "demo": "node tools/demo.mjs",
    "test:e2e": "RUN_SOCKET_TESTS=1 node --test tests/e2e/",
    "demo:gemini": "GEMINI_API_KEY=\"$(security find-generic-password -s GEMINI_API_KEY -w)\" GEMINI_MODEL=\"${GEMINI_MODEL:-gemini-flash-lite-latest}\" node tools/demo.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@types/qrcode": "^1.5.5"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "phaser": "^3.80.0",
    "ws": "^8.18.0",
    "qrcode": "^1.5.4",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/noto-sans-kr": "^5.1.0"
  }
}
